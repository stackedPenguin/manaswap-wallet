# Solana RPC URL (get one from https://www.helius.dev/ or other providers) 
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
VITE_HELIUS_API_KEY=YOUR_HELIUS_API_KEY 

# Jupiter Ultra API Key (optional, for swap 
functionality) VITE_JUPITER_ULTRA_API_KEY=YOUR_JUPITER_API_KEY

# The Graph API Key (for Uniswap V3 position fetching, get from https://thegraph.com/studio/)
VITE_THEGRAPH_API_KEY=YOUR_THEGRAPH_API_KEY
